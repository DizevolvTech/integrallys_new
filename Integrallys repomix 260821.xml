'use client'

import { useEffect, useRef } from 'react'
import { toast } from 'sonner'
import { useApi } from '@/hooks/use-api'

/**
 * Polling curto do prontuário aberto (substituto de Realtime quando o client
 * Supabase browser não está disponível). Notifica se outro usuário atualizou.
 */
export function useProntuarioLiveSync(pacienteId: string | null | undefined, intervalMs = 8000) {
  const api = useApi()
  const lastUpdated = useRef<string | null>(null)

  useEffect(() => {
    if (!pacienteId) return

    let cancelled = false

    const tick = async () => {
      try {
        const res = await api.get<{
          data: Array<{ pacienteId?: string; updatedAt?: string; updated_at?: string }>
        }>('/api/prontuarios')
        if (cancelled) return
        const mine = (res.data ?? []).filter((row) => String(row.pacienteId ?? '') === String(pacienteId))
        const newest = mine
          .map((row) => String(row.updatedAt ?? row.updated_at ?? ''))
          .filter(Boolean)
          .sort()
          .at(-1)
        if (!newest) return
        if (lastUpdated.current && lastUpdated.current !== newest) {
          toast.info('Prontuário atualizado por outro usuário — recarregue se necessário.')
        }
        lastUpdated.current = newest
      } catch {
        // silencioso — sync best-effort
      }
    }

    void tick()
    const id = window.setInterval(() => void tick(), intervalMs)
    return () => {
      cancelled = true
      window.clearInterval(id)
    }
  }, [api, pacienteId, intervalMs])
}
</file>

