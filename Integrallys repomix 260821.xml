              <p className="font-normal text-[var(--app-text-secondary)] dark:text-app-text-muted">
                <span className="font-normal">Especialista:</span> {item.especialista}
              </p>
              <p className="font-normal text-[var(--app-text-secondary)] dark:text-app-text-muted">
                <span className="font-normal">Horário:</span> {item.horario}
              </p>
              <p className="font-normal text-[var(--app-text-secondary)] dark:text-app-text-muted">
