  gap: 6px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px 11px;
  font-size: 11.5px;
  color: var(--text-muted);
  font-family: 'DM Mono', monospace;
}

.meta-chip .dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ── CONTAINER ── */
.container {
  max-width: 1060px;
  margin: 0 auto;
  padding: 40px 40px 80px;
}

/* ── HERO ── */
.hero {
  margin-bottom: 48px;
  padding: 36px 40px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--orange);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 280px; height: 280px;
  background: radial-gradient(circle, var(--orange-dim) 0%, transparent 70%);
  pointer-events: none;
