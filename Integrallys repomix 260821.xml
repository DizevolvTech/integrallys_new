        tipo,
        produtoId,
        de: movFiltroDe || undefined,
        ate: movFiltroAte || undefined,
        limit: PAGE_SIZE_MOVIMENTACOES,
        offset: page * PAGE_SIZE_MOVIMENTACOES,
