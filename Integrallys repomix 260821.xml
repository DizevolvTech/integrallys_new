                    <div className="flex items-center gap-1">
                      <Button variant="ghost" size="icon" className="rounded-full hover:bg-app-bg-secondary dark:hover:bg-app-hover" onClick={() => handleEdit(tarefa)}>
                        <Edit2 className="h-4 w-4" />
