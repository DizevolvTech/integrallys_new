                    required
                    className="h-11 pl-11"
                  />
                </div>
              </div>

              <div className="space-y-2">
                <label
                  className={`text-sm transition-colors duration-300 ${isDarkMode ? "text-[#d1d5dc]" : "text-[var(--app-text-primary)]"}`}
                >
                  Senha
