                      </div>
                    </TableCell>
                    <TableCell className="px-6 py-5">
                      {getPreferenciaHorarioBadge(patient.preferenciaHorario)}
                    </TableCell>
                    <TableCell className="px-6 py-5">
                      {getPriorityBadge(patient.priority)}
