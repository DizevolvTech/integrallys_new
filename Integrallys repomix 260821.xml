            )}
          </div>
        </>
      ) : (
        <>
          {/* Green banner */}
          <div className="bg-green-50 dark:bg-transparent border-l-4 border-green-500 p-4 rounded-r-[10px]">
            <p className="text-green-700 dark:text-green-300 font-normal text-sm">
